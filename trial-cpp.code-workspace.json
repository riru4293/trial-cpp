{
	"folders": [
		{
			"name": "trial-cpp (main)",
			"path": "."
		}
	],
	"settings": {
		"files.trimTrailingWhitespace": true,
		"editor.formatOnType": false,
		"editor.formatOnPaste": false,
		"editor.formatOnSave": false,
		"idf.espIdfPath": "${userHome}/esp/latest",
		"idf.pythonInstallPath": "${userHome}/.espressif/python_env/idf6.1_py3.13_env/bin/python",
		"idf.openOcdConfigs": [
			"board/esp32c6-builtin.cfg"
		],
		"idf.port": "/dev/ttyACM0",
		"idf.toolsPath": "${userHome}/.espressif",
		"idf.customExtraVars": {
			"IDF_TARGET": "esp32c6"
		},
		"clangd.path": "${userHome}/.espressif/tools/esp-clang/esp-20.1.1_20250829/esp-clang/bin/clangd",
		"clangd.arguments": [
			"--folding-ranges",
			"--background-index",
			"--clang-tidy",
			"--completion-style=detailed",
			"--header-insertion=iwyu",
			"--query-driver=${userHome}/.espressif/tools/riscv32-esp-elf/esp-15.2.0_20251204/riscv32-esp-elf/bin/riscv32-esp-elf-g++",
			"--compile-commands-dir=${workspaceFolder}/build"
		],
		"remote.extensionKind": {
			"llvm-vs-code-extensions.vscode-clangd": [
				"workspace"
			],
			"espressif.esp-idf-extension": [
				"workspace"
			]
		},
		"terminal.integrated.profiles.linux": {
			"bash (ESP-IDF)": {
				"path": "bash",
				"args": [
					"-c",
					". ${userHome}/esp/latest/export.sh && exec bash || (echo 'ESP-IDF export.sh failed'; exec bash)"
				]
			}
		},
		"terminal.integrated.defaultProfile.linux": "bash (ESP-IDF)",
		"cSpell.words": [
			"endverbatim",
			"ESP_LOGD",
			"ESP_LOGE",
			"ESP_LOGI",
			"ESP_LOGV",
			"ESP_LOGW",
			"espressif",
			"iwyu",
			"riscv"
		]
	}
}